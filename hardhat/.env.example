# The private key is intentionally not stored here. Use:
# pnpm hardhat keystore set DEPLOYER_PRIVATE_KEY

# Block time used to translate market durations into block counts.
# Leave unset to use the value measured at deploy time (scripts/block-time.ts).
# BLOCK_TIME_MS=195

# RITUAL prepaid into the contract's RitualWallet balance at deploy time.
# Pays for every scheduled resolution and the HTTP precompile call inside it.
EXECUTION_FUNDING=0.5

# Pass these inline when using fund.ts, status.ts, or create-demo-market.ts.
# PREDICT_ADDRESS=0x
# ORACLE_URL=https://your-tunnel.example/api/oracle/eth
